# Скопируйте в .env.local и заполните. Сам .env.local в git не попадает.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Только для сборщика вакансий (main.py). Никогда не используйте его во фронтенде
# и не добавляйте префикс NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Yandex Cloud AI Studio — одна модель на сайт и сборщик вакансий.
# Данные пользователей обрабатываются только в России. Сервисный аккаунт с ролью
# ai.languageModels.user → API-ключ; каталог — идентификатор каталога (b1g…).
YANDEX_API_KEY=your-yandex-api-key
YANDEX_FOLDER_ID=your-folder-id
# Необязательно: модели по порядку перебора (по умолчанию qwen3-235b-a22b-fp8/latest,yandexgpt/latest)
# YANDEX_AI_MODELS=qwen3-235b-a22b-fp8/latest,yandexgpt/latest
