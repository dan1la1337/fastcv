# Скопируйте в .env.local и заполните. Сам .env.local в git не попадает.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Только для сборщика вакансий (main.py). Никогда не используйте его во фронтенде
# и не добавляйте префикс NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio → API keys. Нужен и сайту (сопроводительные письма), и сборщику.
GEMINI_API_KEY=your-gemini-api-key
